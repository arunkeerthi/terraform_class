provider "aws" {
  shared_config_files      = ["/root/terraform/ec2/.aws/config"]
  shared_credentials_files = ["/root/terraform/ec2/.aws/credentials"]
  profile                  = "dev"
  region                   = "us-east-1"
}

resource "aws_instance" "example" {
  instance_type = "t2.micro"
  ami           = "ami-0ec10929233384c7f"

  tags = {
    Name        = "My-EC2"
    Environment = "Dev"
  }
}
